# ==== Server ====
NODE_ENV=production
PORT=5000

# ==== PostgreSQL (tự rotate mật khẩu mới — mật khẩu cũ đã lộ trong git history) ====
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-strong-db-password
DB_NAME=your-db-name

# ==== Auth (tự generate secret mới, tối thiểu 64 ký tự ngẫu nhiên) ====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_ROOT_KEY=change-me-admin-invite-key
# Tài khoản admin mặc định được seed từ các biến này (không đăng ký admin qua API)
ADMIN_EMAIL=admin@agentlab.dev
ADMIN_PASSWORD=change-me-strong-admin-password
MEMBER_PASSWORD=123456

# ==== CORS (domain frontend production, phân tách bằng dấu phẩy) ====
CORS_ORIGIN=https://your-frontend-domain.com

# URL frontend dùng làm return_url/cancel_url của PayPal Checkout
APP_URL=https://your-frontend-domain.com

# (Tuỳ chọn) URL nội bộ tới container web/nginx — server fetch shell SPA từ đây
# để render meta tag cho crawler (dynamic rendering). VD trong docker-compose:
# WEB_ORIGIN=http://web:80
WEB_ORIGIN=http://web:80

# ==== PayPal (REST API app từ developer.paypal.com; sandbox trước, PAYPAL_ENV=live khi go-live) ====
PAYPAL_CLIENT_ID=AQBitl_up5pAT9uQkVUzd2y9HxsG4szai6-9vJ0P8UAZNherkyAo5jdkLm_1R1BnD_ECOz9bSnGDBgWn
PAYPAL_CLIENT_SECRET=AQBitl_up5pAT9uQkVUzd2y9HxsG4szai6-9vJ0P8UAZNherkyAo5jdkLm_1R1BnD_ECOz9bSnGDBgWn
PAYPAL_ENV=sandbox

# ==== Resend email ====
RESEND_API_KEY=re_xxx
MAIL_FROM=AgentLab <no-reply@your-verified-domain.com>

# ==== Mã hoá mật khẩu tài khoản bán (AES-256-GCM, đúng 32 bytes) ====
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars-00000000000000000000000000000000

# ==== Chat tu van khach hang (Grok free qua OpenRouter) ====
OPENROUTER_API_KEY=sk-or-v1-xxx
# Model free mac dinh; cac lua chon khac: x-ai/grok-4-fast:free, ...
GROK_MODEL=x-ai/grok-4-fast:free

# ==== Watch & Earn (xem ADS tich tien — postback S2S) ====
# BitLabs: App Secret tu dashboard (HMAC-SHA1 tren toan bo callback URL, tru tham so hash).
# De trong => postback bi tu choi khi chay production.
ADS_BITLABS_APP_SECRET=
# Shared secret dung cho cac provider khac (Torox/AdGate/...) — gắn ?secret=<giá trị> vao postback URL
# ban cau hinh trong dashboard cua provider. De trong => tu choi khi chay production.
ADS_POSTBACK_SECRET=change-me-shared-postback-secret
# URL iframe offerwall (placeholder {uid} se duoc thay bang user id) — cau hinh trong Admin > Watch & Earn
# Vi du: https://api.torox.io/offerwall?uid={uid}&appid=1234

# ==== freeCodeCamp News archive (scripts/fcc-news) ====
# MongoDB Atlas -> Connect -> Drivers. Dat IP access + user doc truoc khi chay crawler.
# De trong neu khong dung MongoDB — crawler tu fallback ve JSONL (--store file).
# Cac bien nay cung cap du lieu cho API cong khai /api/blog/fcc (trang /blog/archive).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
FCC_MONGODB_DB=fcc_news
FCC_MONGODB_COLLECTION=posts
